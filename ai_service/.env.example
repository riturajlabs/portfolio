# Example env file for ai_service (Render / local dev).
# Copy this file to `.env` and fill in real secrets. DO NOT commit `.env`.
#
# ⚠️  ROTATE THESE KEYS REGULARLY:
#   - Groq:    https://console.groq.com/keys
#   - Gemini:  https://aistudio.google.com/apikey
#   - AI Service Key: any random 32+ char string (used as X-API-Key gate)
# ⚠️  NEVER paste real keys into this file in a public repo.

# --- AI Provider Keys ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Required for real provider-backed ingestion/embeddings (GEMINI_API_KEY is the
# actual embedding-provider key used by services/embeddings.py). Without a real
# key the service cannot embed content in production.
GEMINI_API_KEY=

# --- GitHub (server-side proxy) ---
# Create at https://github.com/settings/tokens (no scopes needed for public data).
# Boosts the /api/github rate limit from 60 to 5000 req/hr.
GITHUB_TOKEN=
GITHUB_USERNAME=riturajlabs

# --- Auth: shared secret between frontend and backend ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_KEY=

# --- Trusted client IP (chat rate-limit bucketing) ---
# Vercel's edge (middleware.js) stamps the real client IP, signed with
# AI_SERVICE_KEY, so the chat limit buckets per client instead of per shared
# Render proxy. Set this to `x-vercel-client-ip` in production; leave unset for
# local dev and tests (only that header name is accepted).
TRUSTED_CLIENT_IP_HEADER=
# Optional; defaults to AI_SERVICE_KEY (the value the edge signs with). Set only
# to rotate the signing secret independently — it must then match BACKEND_API_KEY
# on the Vercel project.
CLIENT_IP_SIGNING_SECRET=

# --- Admin (operator-only endpoints) ---
# Token required by POST /admin/reingest and POST /admin/cache/clear (sent as the
# X-Admin-Token header by the backend's publish flow). Distinct from
# AI_SERVICE_KEY so a leaked chat key never grants re-ingest or cache-purge
# rights. MUST match the backend's AI_SERVICE_ADMIN_TOKEN: use the SAME long
# random secret in both deployments (the placeholders differ here only to make
# clear they are two separate settings). Leave empty to disable the admin surface
# entirely (404).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- ChromaDB & Knowledge Base ---
CHROMA_DB_PATH=./chroma_db
KNOWLEDGE_FILE=./knowledge_base.json
COLLECTION_NAME=portfolio_knowledge

# --- Canonical knowledge source (Phase 9) ---
# The AI assistant ingests GET /api/content from the backend as its
# authoritative knowledge. Production MUST override CONTENT_API_URL with the
# deployed backend. KNOWLEDGE_SOURCE=api is the default; set KNOWLEDGE_SOURCE=file
# ONLY as a rollback to re-ingest the legacy knowledge_base.json.
CONTENT_API_URL=http://127.0.0.1:8001/api/content
CONTENT_API_TIMEOUT=10
KNOWLEDGE_SOURCE=api

# --- Retrieval and provider tuning ---
CHAT_TOP_K=5
CHAT_SCORE_THRESHOLD=0.7
SCORE_THRESHOLD=0.65
SHORT_QUERY_TOKEN_THRESHOLD=100
PRIMARY_PROVIDER=auto
CHAT_MAX_TOKENS=512
CHAT_QUERY_TIMEOUT=10
CHAT_SSE_KEEPALIVE=15
CHAT_GEMINI_MODEL=gemini-2.5-flash
CHAT_TEMPERATURE=0.1
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW=60

# --- Response and embedding caches ---
LLM_CACHE_ENABLED=1
LLM_CACHE_TTL_SECONDS=120
LLM_CACHE_MAX_ENTRIES=256
EMBEDDING_CACHE_DISABLED=0
EMBEDDING_CACHE_MAX_ROWS=1000
EMBEDDING_CACHE_PATH=./embedding_cache.sqlite

# Set to 1 only for a deliberate one-time re-ingestion (for example after an
# embedding model change); leave unset during normal operation.
# FORCE_REINGEST=1

# --- Resend (legacy direct `/api/contact` route) ---
# Render's free tier blocks outbound SMTP (port 587), so we use Resend's
# HTTPS API instead. Sign up at https://resend.com (free, 100 emails/day),
# verify a sending domain, then create an API key.
RESEND_API_KEY=
# Must be a verified sender on Resend. For testing without a custom domain,
# use the sandbox sender `onboarding@resend.dev`.
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=riturajlabs@outlook.com

# --- CORS ---
# Comma-separated list of allowed origins. Default if unset:
#   https://riturajlabs.vercel.app, http://localhost:5173, http://127.0.0.1:5173
# Use "*" to allow any origin (NOT recommended in production).
ALLOWED_ORIGINS=https://riturajlabs.vercel.app,http://localhost:5173

# --- Runtime ---
PORT=8000

# Render must use production so `/chat` authentication is enforced. Local
# development may use `ENV=development` to intentionally bypass that gate.
ENV=development