# Example env file for ai_service (Render / local dev).
# Copy this file to `.env` and fill in real secrets. DO NOT commit `.env`.
#
# ⚠️  ROTATE THESE KEYS REGULARLY:
#   - Groq:    https://console.groq.com/keys
#   - Gemini:  https://aistudio.google.com/apikey
#   - AI Service Key: any random 32+ char string (used as X-API-Key gate)
# ⚠️  NEVER paste real keys into this file in a public repo.

# --- AI Provider Keys ---
GROQ_API_KEY=replace_me_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=replace_me_gemini_key

# --- GitHub (server-side proxy) ---
# Create at https://github.com/settings/tokens (no scopes needed for public data).
# Boosts the /api/github rate limit from 60 to 5000 req/hr.
GITHUB_TOKEN=replace_me_github_pat
GITHUB_USERNAME=riturajlabs

# --- Auth: shared secret between frontend and backend ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_KEY=replace_me_random_32_char_secret

# --- ChromaDB & Knowledge Base ---
CHROMA_DB_PATH=./chroma_db
KNOWLEDGE_FILE=./knowledge_base.json
COLLECTION_NAME=portfolio_knowledge

# --- SMTP (for /api/contact public form) ---
# Gmail example shown below. For other providers, change SMTP_HOST/SMTP_PORT.
# Gmail "App Password": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=riturajlabs@gmail.com
SMTP_PASS=replace_me_gmail_app_password
CONTACT_FROM_EMAIL=riturajlabs@gmail.com
CONTACT_TO_EMAIL=riturajlabs@outlook.com

# --- CORS ---
# Comma-separated list of allowed origins. Default if unset:
#   https://riturajlabs.vercel.app, http://localhost:5173, http://127.0.0.1:5173
# Use "*" to allow any origin (NOT recommended in production).
ALLOWED_ORIGINS=https://riturajlabs.vercel.app,http://localhost:5173

# --- Runtime ---
PORT=8000