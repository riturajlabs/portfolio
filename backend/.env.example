# backend/.env.example — copy to backend/.env for local development.
#
# Names and empty values only. Real values live in the platform secret store
# (SECURITY.md §8.1) and never in the repository.
#
#   cp .env.example .env   # then fill in the blanks

# PostgreSQL connection string. Required.
# The async driver prefix is optional: a plain postgresql:// URL is rewritten to
# postgresql+asyncpg:// automatically. Keep the provider's `?sslmode=require`
# (and Neon's `&channel_binding=require`): `app/config.py` translates `sslmode`
# to the `ssl` keyword asyncpg actually accepts and drops libpq-only parameters,
# which asyncpg would otherwise reject on the first connection.
DATABASE_URL=

# Phase 10 — object storage for admin-uploaded project images (Neon Object
# Storage, or any S3-compatible endpoint). All four AWS_* names are exactly what
# `neon deploy` writes into `.env`, so nothing has to be renamed: the values a
# branch reports are the values this app reads. They are capabilities (read/write
# to one bucket), so they live in the platform secret store, never in the repo.
# When any of the first three is blank, `POST /api/admin/uploads` answers 503 and
# the editor falls back to the `/images/projects/*.webp` path form.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Neon's endpoint is branch-scoped: it embeds the branch id, so it changes if the
# branch is recreated. Format: https://<branch>.storage.<region>.aws.neon.tech
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# The bucket uploaded images land in. It MUST be `public_read`: a project image
# is baked into the static build as a stable <img src> URL and anonymous browsers
# fetch it, so a private bucket (or presigned URLs) cannot work. `neon.ts` declares
# the bucket; this must name the same one.
S3_BUCKET=media

# Largest accepted upload, in bytes. A cover image is a web asset, not a document;
# 5 MB is generous for a 1600px WebP and bounds what one request can hold in memory.
S3_IMAGE_MAX_BYTES=5000000

# The resume lands in a DIFFERENT, PRIVATE bucket (`uploads`, created by
# `neon init`). A resume is a document, not a web asset: it has no anonymous URL
# and is read only through `GET /api/resume`. The bucket access mode is fixed at
# creation, which is why the resume cannot go in the public `media` bucket.
S3_RESUME_BUCKET=uploads

# Largest accepted resume, in bytes. 10 MB comfortably holds a multi-page PDF.
S3_RESUME_MAX_BYTES=10000000

# Public `GET /api/resume` budget: requests per window, per client IP.
RESUME_RATE_LIMIT=60
RESUME_RATE_WINDOW_SECONDS=60

# Local admin provisioning only. Server-side values; never use VITE_* names.
# `python -m db.admin` creates the first account. Add `--reset` only when you
# intentionally want to replace the existing account's email/password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# One-time bootstrap for free-tier production (DEPLOYMENT.md §6.6). When set to
# a ≥32-character secret, `POST /api/admin/bootstrap` is enabled and can create
# the first administrator AND load the initial content snapshot in one atomic
# request (run `npm run admin:bootstrap` from your workstation). Leave EMPTY in
# local development and after the first production bootstrap: empty disables the
# endpoint entirely (404). Never commit a real value.
ADMIN_BOOTSTRAP_TOKEN=

# development | staging | production
ENVIRONMENT=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG | NOTSET
LOG_LEVEL=INFO

# Per-IP rate-limiting identity (SECURITY.md §3.6a). The header written by the
# trusted edge proxy that carries the real client IP. Leave unset for local
# development and tests, where the socket peer *is* the caller. On Render set
# TRUSTED_PROXY_HEADER=cf-connecting-ip, or every caller shares the load
# balancer's bucket and the per-IP limits collapse to one global window.
# Only "cf-connecting-ip" is accepted; "x-forwarded-for" is refused at startup
# because Cloudflare appends to it rather than overwriting it.
TRUSTED_PROXY_HEADER=

# Isolated PostgreSQL database used by `pytest`. Never point this at the
# development or production database.
TEST_DATABASE_URL=

# Phase 3 — browser origins allowed to read GET /api/content (CORS).
# Comma-separated bare origins: scheme://host[:port]. No paths, no trailing
# slashes. Leave unset to use the defaults in app/config.py:
# https://riturajlabs.vercel.app, http://localhost:5173, http://127.0.0.1:5173
# Set it in production to exactly the deployed frontend origins.
# A wildcard `*` is refused in production and staging, and is only tolerated in
# development with a loud startup warning.
ALLOWED_ORIGINS=

# Phase 3 — public rate limit for GET /api/content, per client IP (API.md §8).
# Defaults match the documented contract; override only to tighten it.
CONTENT_RATE_LIMIT=300
CONTENT_RATE_WINDOW_SECONDS=60

# Phase 4 — Admin session lifetimes (SECURITY.md §4.1).
# 12-hour idle timeout, 7-day absolute timeout.
ADMIN_SESSION_IDLE_SECONDS=43200
ADMIN_SESSION_ABSOLUTE_SECONDS=604800

# Phase 4 — Admin login rate limits (API.md §8, SECURITY.md §4.4).
# 10 attempts / 15 minutes per IP; 5 failed attempts / 15 minutes per email.
ADMIN_LOGIN_IP_LIMIT=10
ADMIN_LOGIN_IP_WINDOW_SECONDS=900
ADMIN_LOGIN_EMAIL_FAILURE_LIMIT=5
ADMIN_LOGIN_EMAIL_WINDOW_SECONDS=900

# Phase 8 — `POST /api/contact` (API.md §2.3). Same names ai_service used, so an
# operator migrating environment variables changes nothing. The key lives in the
# platform secret store; the row is stored even when delivery fails.
# RESEND_API_KEY=
# RESEND_API_URL=https://api.resend.com/emails
# CONTACT_FROM_EMAIL=onboarding@resend.dev
# CONTACT_TO_EMAIL=riturajlabs@outlook.com

# Phase 8 — contact per-IP rate limit (API.md §8). 5/minute per IP.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=60

# Phase 8 — `GET /api/github` (API.md §2.2). Same names ai_service used.
# Without a username the proxy answers 404, like the misspelt-user path.
# GITHUB_USERNAME=riturajlabs
# GITHUB_TOKEN=

# Phase 4 — server-side publish (ADR-017). The Vercel Deploy Hook URL that
# `POST /api/admin/publish` calls to rebuild the public site. It MUST be a real
# deploy hook URL (e.g. https://api.vercel.com/v1/integrations/deploy/prj_.../...):
# it is a capability token, so anyone holding it can start a build. It lives only
# in the platform secret store and is never sent to the browser, which is why the
# admin "Rebuild site" button calls the backend instead of the hook directly.
# Leave blank to disable the feature; the endpoint then reports "not configured"
# instead of failing.
DEPLOY_HOOK_URL=https://YOUR-DEPLOYMENT-HOOK-URL

# Seconds to wait for the deploy hook before reporting a timeout. A deploy hook
# answers quickly; raise only if the build trigger is slow.
DEPLOY_HOOK_TIMEOUT_SECONDS=10

# Phase 9 — AI re-ingestion (ADR-017). After triggering a build, publish also
# asks the AI service to re-read GET /api/content so hidden/deleted content stops
# being quotable in chat. AI_SERVICE_URL is the AI service base URL as a bare
# origin (scheme://host[:port], no path — publish appends /admin/reingest),
# e.g. https://portfolio-lxdx.onrender.com. AI_SERVICE_ADMIN_TOKEN must match the
# AI service's ADMIN_TOKEN: the SAME long random secret in both deployments (a
# capability token, distinct from AI_SERVICE_KEY). Both live only in the platform
# secret store. Leave either blank to disable the step; publish then reports it
# "not configured".
AI_SERVICE_URL=https://YOUR-AI-SERVICE-URL
AI_SERVICE_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Seconds to wait for re-ingestion; it fetches the content API and re-embeds
# changed chunks, so it is slower than the deploy hook.
AI_SERVICE_TIMEOUT_SECONDS=30