{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2"
  },
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && vite build && node scripts/assert-admin-bundle.mjs && vite build --config vite.prerender.config.js && node scripts/generate-project-pages.mjs && node scripts/generate-seo-discovery.mjs",
    "build:spa": "vite build",
    "content:build": "node scripts/build-content.mjs",
    "prerender": "node scripts/generate-project-pages.mjs",
    "discovery": "node scripts/generate-seo-discovery.mjs",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/migration-validation.test.mjs",
    "test:watch": "vitest --exclude tests/migration-validation.test.mjs",
    "test:migration-validation": "vitest run tests/migration-validation.test.mjs",
    "test:api": "cd backend && TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://$(whoami)@/portfolio_test?host=/var/run/postgresql}\" .venv/bin/python -m pytest -q",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "assert:admin-bundle": "node scripts/assert-admin-bundle.mjs",
    "preview": "vite preview",
    "seed:extract": "node scripts/extract-content.mjs",
    "seed:load": "cd backend && .venv/bin/python -m db.seed",
    "admin:setup": "cd backend && .venv/bin/python -m db.admin",
    "admin:reset": "cd backend && .venv/bin/python -m db.admin --reset",
    "admin:bootstrap": "node scripts/bootstrap-content.mjs",
    "seed:verify": "node scripts/compare-content.mjs",
    "lint:ai_service": "cd ai_service && .venv/bin/ruff check .",
    "test:ai_service": "cd ai_service && .venv/bin/python -m pytest -q",
    "local:setup": "node scripts/local.mjs setup",
    "local:up": "node scripts/local.mjs up",
    "local:dev": "node scripts/local.mjs dev",
    "local:status": "node scripts/local.mjs status",
    "local:check": "node scripts/local.mjs check",
    "local:stop": "node scripts/local.mjs stop",
    "local:prod:setup": "node scripts/local.mjs prod:setup",
    "local:prod:build": "node scripts/local.mjs prod:build",
    "local:prod:up": "node scripts/local.mjs prod:up",
    "local:prod:status": "node scripts/local.mjs prod:status",
    "local:prod:check": "node scripts/local.mjs prod:check",
    "local:prod:logs": "node scripts/local.mjs prod:logs",
    "local:prod:stop": "node scripts/local.mjs prod:stop"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "@vercel/functions": "^3.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.42.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-type-animation": "^3.2.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.1.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^8.1.1",
    "vitest": "^5.0.3"
  }
}
